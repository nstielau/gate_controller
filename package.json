{
  "name": "drawbridge-web",
  "private": true,
  "scripts": {
    "build": "node tools/build_web.mjs",
    "test": "node --test firebase/functions/test/*.test.cjs web/test/*.test.cjs",
    "test:live": "node tools/test_web_live.mjs",
    "test:web": "playwright test",
    "deploy": "firebase deploy --project drawbridge-45487 --account nick.stielau@gmail.com --only functions,hosting,firestore --non-interactive",
    "test:emulator": "firebase emulators:exec --project demo-drawbridge --only firestore 'node --test firebase/functions/test-emulator/*.test.cjs'"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "node": "22.23.2"
  }
}
